{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    // Added 8/18 — the documented @types-stub-shadowing fix (learning-demo
    // README). Without this whitelist the deprecated @types/axios@0.9.36 stub
    // shadows real axios types, and that stub declares no `interceptors`, so
    // scenario 12's `.interceptors.request.use(...)` cannot resolve and the
    // app reproduces only half of P_10's real interceptor shape.
    // learning-demo deliberately KEEPS the no-whitelist state to demonstrate
    // the shadowing; this app carries the real-axios identity instead, so the
    // two bundles cover both identities rather than duplicating one.
    "types": ["node"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
